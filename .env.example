# Trader6ix — environment template. Copy to .env.local and fill in.
# Never commit .env.local, and never prefix a secret with NEXT_PUBLIC_ (that
# ships it to the browser).

# --- Arc network -------------------------------------------------------------
# 5042 = Arc Mainnet, 5042002 = Arc Testnet. Everything else (RPC, explorer,
# token registry, Tower chain id, Privy chain) is derived from this value.
NEXT_PUBLIC_ARC_CHAIN_ID=5042
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.mainnet.arc.io
NEXT_PUBLIC_ARC_EXPLORER_URL=https://explorer.arc.io
# Testnet only — leave empty on mainnet so the UI hides the faucet.
NEXT_PUBLIC_FAUCET_URL=

# --- Privy (wallet auth AND the JWT issuer) ----------------------------------
# Public app id; also the expected `aud` claim of every access token.
NEXT_PUBLIC_PRIVY_APP_ID=
# Privy dashboard -> App settings -> Verification key (PEM).
# Signs/verifies nothing — it VERIFIES the access tokens Privy issues. When it
# is unset every authenticated route fails closed with 401.
PRIVY_VERIFICATION_KEY=
# Optional: enables server-side Privy lookups (refreshing a linked wallet).
PRIVY_APP_SECRET=
# Comma-separated Privy DIDs granted the admin role (bootstraps the first admin
# without touching SQL). Example: did:privy:abc123,did:privy:def456
ADMIN_PRIVY_DIDS=

# --- Postgres -----------------------------------------------------------------
# Pooled app connection (Supabase "Transaction pooler", port 6543)
DATABASE_URL=
# Direct connection used by migrations (Supabase "Direct connection", port 5432)
DIRECT_URL=

# --- Tower Exchange (Arc swap router) ----------------------------------------
# Server-side only — the API key never reaches the browser.
TOWER_API_KEY=
TOWER_API_BASE_URL=https://www.tower.exchange/api/public
NEXT_PUBLIC_TOWER_ENABLED=true

# --- Hibachi (spot + perps backend; Perps is not live yet) -------------------
# Account type: "trustless" (ECDSA-signed) or "managed" (HMAC-signed)
HIBACHI_ACCOUNT_TYPE=trustless
HIBACHI_API_KEY=
HIBACHI_API_SECRET=
HIBACHI_ACCOUNT_ID=
HIBACHI_API_BASE_URL=https://api.hibachi.xyz
HIBACHI_DATA_API_BASE_URL=https://data-api.hibachi.xyz

# --- Circle StableFX (stablecoin FX; not live yet) ---------------------------
# Requires a Circle KYB/AML-gated API key — see src/server/stablefx/client.ts
STABLEFX_API_KEY=
STABLEFX_API_BASE_URL=https://api-sandbox.circle.com
NEXT_PUBLIC_STABLEFX_ENABLED=false

# --- Curve Finance (alternative spot venue) -----------------------------------
# Set once a real USDC/EURC pool address is verified for the active network.
NEXT_PUBLIC_CURVE_USDC_EURC_POOL=

# --- Goldsky (indexed data layer; not used — the API reads the chain directly) -
# GOLDSKY_API_KEY is used only by the CLI deploy, never at runtime.
GOLDSKY_API_KEY=
NEXT_PUBLIC_GOLDSKY_GRAPHQL_URL=
