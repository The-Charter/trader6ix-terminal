# --- Arc Testnet ---
NEXT_PUBLIC_ARC_CHAIN_ID=5042002
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_ARC_EXPLORER_URL=https://testnet.arcscan.app
NEXT_PUBLIC_FAUCET_URL=https://faucet.circle.com

# --- Privy (wallet auth) ---
NEXT_PUBLIC_PRIVY_APP_ID=

# --- Hibachi (spot + perps backend) ---
# Account type: "trustless" (ECDSA-signed) or "managed" (HMAC-signed)
HIBACHI_ACCOUNT_TYPE=trustless
HIBACHI_API_KEY=
HIBACHI_API_SECRET=
HIBACHI_ACCOUNT_ID=
HIBACHI_API_BASE_URL=https://api.hibachi.xyz
HIBACHI_DATA_API_BASE_URL=https://data-api.hibachi.xyz

# --- Token logo source ---
# CoinGecko is used unauthenticated (public asset image CDN); set a key only if you hit rate limits
COINGECKO_API_KEY=

# --- Circle StableFX (stablecoin FX) ---
# Requires Circle KYB/AML-gated API key — see lib/stablefx/client.ts
STABLEFX_API_KEY=
STABLEFX_API_BASE_URL=https://api-sandbox.circle.com
NEXT_PUBLIC_STABLEFX_ENABLED=false

# --- Curve Finance (spot, Arc testnet) ---
# Set once the real USDC/EURC pool address is verified (see lib/adapters/curve-adapter.ts)
NEXT_PUBLIC_CURVE_USDC_EURC_POOL=

# --- Goldsky (indexed data layer) ---
# Set once a subgraph is deployed via the Goldsky CLI (see lib/adapters/goldsky-data-adapter.ts)
NEXT_PUBLIC_GOLDSKY_GRAPHQL_URL=

# --- Demo mode ---
# When true (default), Perps/Spot/FX pages use simulated Mock adapters so the
# product can be demoed end-to-end even while real integrations are pending.
# Set to "false" once Hibachi/Curve/StableFX are confirmed working to switch
# the whole app to live/testnet mode with zero other code changes.
NEXT_PUBLIC_DEMO_MODE=true
